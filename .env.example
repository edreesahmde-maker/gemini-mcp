# Required
GEMINI_API_KEY=your-gemini-api-key-here

# Strongly recommended for public deployments: endpoint becomes /mcp/<MCP_SECRET>
MCP_SECRET=

# Optional model overrides (defaults shown)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.0-generate-001
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# Render sets PORT automatically — only needed for local testing
PORT=3000
